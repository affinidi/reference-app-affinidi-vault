# Envs for Affinidi Login
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="this-is-very-secret-dont-tell-anyone"

PROVIDER_CLIENT_ID=""
PROVIDER_CLIENT_SECRET=""
PROVIDER_ISSUER=""

# Personal Access Token envs for credential issuance and Affinidi Iota Framework
PROJECT_ID=""
TOKEN_ID=""
PRIVATE_KEY=""
PASSPHRASE="" # Optional. Required if private key is encrypted
KEY_ID="" # Optional. Required if token's key id is different from token id

# Optional: Auth0 login — authN for the websocket data-sharing flow when NOT
# using Affinidi Vault (e.g. the TDK Vault). Leave empty to keep only Affinidi
# Login. Create a free Auth0 tenant + a "Regular Web Application", then set in
# Auth0: Allowed Callback URLs = ${NEXTAUTH_URL}/api/auth/callback/auth0 and
# Allowed Logout URLs = ${NEXTAUTH_URL}. AUTH0_ISSUER is the tenant domain URL,
# e.g. https://your-tenant.us.auth0.com
AUTH0_ISSUER=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
